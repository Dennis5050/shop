# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/nexus_chat

# JWT Security
JWT_SECRET=super_secret_nexus_jwt_key_2026_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=nexus_cookie_secret_key_8899

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Media Uploads
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
